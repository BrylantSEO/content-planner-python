# Content Planner — API Keys
# Copy this file to .env and fill in your keys
# Or configure via the UI: http://localhost:5000 → ⚙ Settings

# Required — LLM via OpenRouter (Claude Sonnet)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — Google SERP data via NodeHub
# Get key: https://nodeshub.io
NODESHUB_API_KEY=

# Optional — Jina Reader (legacy, no longer used for scraping)
# JINA_API_KEY=
